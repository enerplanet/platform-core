# App Configuration
APP_NAME=SpatialHub Auth Service
APP_ENV=production
APP_PORT=8001
APP_HOST=0.0.0.0
APP_TIMEZONE=Europe/Berlin

# Session Configuration
SESSION_TTL_MINUTES=60
COOKIE_DOMAIN=spatialhub.th-deg.de

# URLs
FRONTEND_URL=https://spatialhub.th-deg.de
WEB_URLS=https://spatialhub.th-deg.de

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=s6et
DB_USERNAME=postgres
DB_PASSWORD=your-secure-password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=your-secure-password
REDIS_DATABASE=0

# Keycloak Configuration
KEYCLOAK_URL=https://auth.spatialhub.th-deg.de
KEYCLOAK_REALM=spatialhub
KEYCLOAK_CLIENT_ID=spatialhub
REDIRECT_URL=https://api.spatialhub.th-deg.de/callback-auth
KEYCLOAK_CLIENT_SECRET=

# Backend Service Configuration
BACKEND_SERVICE_URL=http://backend:8000
